NODE_ENV=development
LOG_LEVEL=info

# Storefront under test (Shopify — open root redirects to /password when gated)
BASE_URL=https://bonobos-dev-3.myshopify.com
STORE_PASSWORD=sifrah

BROWSER=chromium
CHANNEL=chrome
HEADLESS=false
SLOW_MO=0
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
EXPECT_TIMEOUT=10000

# Cloudflare resilience
CF_WAIT_MS=120000
PERSIST_STATE=true

# HP_018 — hero has 3 slides on DEV (walk each: Next × 2). Set to 0 to infer from DOM.
HERO_SLIDESHOW_SLIDES=3

TRACE=true
VIDEO=true
SCREENSHOT_ON_FAILURE=true

TEST_USERNAME=
TEST_PASSWORD=
