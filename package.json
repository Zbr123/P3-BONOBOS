{
  "name": "p3-bonobos-automation",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright + Cucumber BDD automation framework (CommonJS, AI-friendly, optimized for Shopify workflows).",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:smoke": "cucumber-js -p smoke",
    "test:regression": "cucumber-js -p regression",
    "test:login": "cucumber-js --tags @login",
    "test:cart": "cucumber-js --tags @cart",
    "test:debug": "cross-env HEADLESS=false SLOW_MO=300 cucumber-js -p debug",
    "test:parallel": "cucumber-js -p parallel",
    "test:retry": "cucumber-js -p retry",
    "report:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "report:open": "allure open ./reports/allure-report",
    "report": "npm run report:generate && npm run report:open",
    "clean": "rimraf reports screenshots logs videos traces && mkdir reports screenshots logs videos traces",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "install:browsers": "playwright install chromium",
    "codegen": "node scripts/playwright-codegen.js"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "automation",
    "shopify",
    "bonobos",
    "page-object-model",
    "stealth",
    "allure"
  ],
  "author": "QA Automation Team",
  "license": "MIT",
  "dependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@playwright/test": "^1.45.0",
    "allure-cucumberjs": "^2.15.1",
    "allure-js-commons": "^2.15.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "faker": "^5.5.3",
    "fs-extra": "^11.2.0",
    "playwright": "^1.45.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "allure-commandline": "^2.29.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
