# =====================================================================
# P3-BONOBOS — environment variables (sample)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- App under test ----
BASE_URL=https://bonobos-dev-3.myshopify.com
ADMIN_URL=
# Storefront password (required when the store is password-protected — Shopify dev shops).
STORE_PASSWORD=

# ---- Browser ----
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
# CHANNEL=chrome      # uncomment to use installed Chrome instead of bundled Chromium

# ---- Timeouts (ms) ----
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
EXPECT_TIMEOUT=10000

# ---- Tracing / video / screenshots ----
# Leave false (default) to avoid trace zips and video files; set true when debugging.
TRACE=false
VIDEO=false
SCREENSHOT_ON_FAILURE=true

# ---- Test credentials (optional; not used by current password-gate tests) ----
# TEST_USERNAME=
# TEST_PASSWORD=

# ---- Cart optional PDP paths (CP_018 inventory edge only) ----
# CP_020 product paths are pinned in `features/cart/cart.data.js` — no env knob needed.
# CART_INVENTORY_EDGE_PRODUCT_PATH=/products/your-sku?variant=123

# ---- PDP module (`features/pdp/`) — high-variant shirt archetype ----
# Pin your spreadsheet PDP URLs when merchandising moves (recommended for PDP_003 six-level shirt).
# PDP_HIGH_VARIANT_SHIRT_PATH=/products/your-master-shirt-handle
# PDP_SHIRT_COLLECTION_PATH=/collections/dress-shirts
# PDP_EVERYDAY_LINEN_SHIRT_PATH=/products/everyday-linen-shirt-handle
# PDP_LOAD_MAX_MS=25000
